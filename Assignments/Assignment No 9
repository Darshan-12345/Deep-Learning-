        "import time\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import torch.optim as optim\n",
        "import torchvision\n",
        "import torchvision.transforms as transforms\n",
        "from torch.utils.data import DataLoader\n",
        "import timm\n",
        "from sklearn.metrics import accuracy_score\n",
        "\n",
        "# 1. Device Configuration\n",
        "device = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "print(f\"Using device: {device}\")\n",
        "\n",
        "# 2. Data Preparation (Using Fashion-MNIST dataset)\n",
        "transform_train = transforms.Compose([\n",
        "    transforms.Grayscale(num_output_channels=3),  # Convert grayscale to 3 channels for pre-trained models\n",
        "    transforms.Resize((224, 224)),\n",
        "    transforms.RandomHorizontalFlip(),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
        "])\n",
        "\n",
        "transform_test = transforms.Compose([\n",
        "    transforms.Grayscale(num_output_channels=3),\n",
        "    transforms.Resize((224, 224)),\n",
        "    transforms.ToTensor(),\n",
        "    transforms.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])\n",
        "])\n",
        "\n",
        "# Load Fashion-MNIST dataset\n",
        "trainset = torchvision.datasets.FashionMNIST(root='./data', train=True, download=True, transform=transform_train)\n",
        "testset = torchvision.datasets.FashionMNIST(root='./data', train=False, download=True, transform=transform_test)\n",
        "\n",
        "# Setup DataLoaders (using subset of 5000 train / 1000 test)\n",
        "train_subset = torch.utils.data.Subset(trainset, range(5000))\n",
        "test_subset = torch.utils.data.Subset(testset, range(1000))\n",
        "\n",
        "batch_size = 32\n",
        "trainloader = DataLoader(train_subset, batch_size=batch_size, shuffle=True, num_workers=2)\n",
        "testloader = DataLoader(test_subset, batch_size=batch_size, shuffle=False, num_workers=2)\n",
        "\n",
        "# 3. Define Training, Evaluation, and Scheduler\n",
        "def train_model(model, trainloader, criterion, optimizer, scheduler=None, epochs=5):\n",
        "    model.train()\n",
        "    start_time = time.time()\n",
        "    for epoch in range(epochs):\n",
        "        running_loss = 0.0\n",
        "        for i, data in enumerate(trainloader, 0):\n",
        "            inputs, labels = data[0].to(device), data[1].to(device)\n",
        "            optimizer.zero_grad()\n",
        "            outputs = model(inputs)\n",
        "            loss = criterion(outputs, labels)\n",
        "            loss.backward()\n",
        "            optimizer.step()\n",
        "            running_loss += loss.item()\n",
        "\n",
        "            if i % 50 == 49:\n",
        "                print(f'Epoch [{epoch+1}/{epochs}], Step [{i+1}/{len(trainloader)}], Loss: {running_loss/50:.4f}')\n",
        "                running_loss = 0.0\n",
        "\n",
        "        if scheduler is not None:\n",
        "            scheduler.step()\n",
        "\n",
        "    training_time = time.time() - start_time\n",
        "    print(f\"Training finished in {training_time:.2f} seconds.\")\n",
        "    return training_time\n",
        "\n",
        "def evaluate_model(model, testloader):\n",
        "    model.eval()\n",
        "    all_preds = []\n",
        "    all_labels = []\n",
        "    start_time = time.time()\n",
        "    with torch.no_grad():\n",
        "        for data in testloader:\n",
        "            images, labels = data[0].to(device), data[1].to(device)\n",
        "            outputs = model(images)\n",
        "            _, predicted = torch.max(outputs.data, 1)\n",
        "            all_preds.extend(predicted.cpu().numpy())\n",
        "            all_labels.extend(labels.cpu().numpy())\n",
        "    inference_time = time.time() - start_time\n",
        "    acc = accuracy_score(all_labels, all_preds)\n",
        "    print(f\"Test Accuracy: {acc * 100:.2f}%\")\n",
        "    print(f\"Inference Time: {inference_time:.2f} seconds\")\n",
        "    return acc, inference_time\n",
        "\n",
        "criterion = nn.CrossEntropyLoss()\n",
        "NUM_EPOCHS = 5  # Increased epochs\n",
        "\n",
        "# 4. Model 1: Convolutional Neural Network (CNN - ResNet18)\n",
        "print(\"\\n--- Training CNN (ResNet18) ---\")\n",
        "cnn_model = timm.create_model('resnet18', pretrained=True, num_classes=10)\n",
        "cnn_model = cnn_model.to(device)\n",
        "optimizer_cnn = optim.Adam(cnn_model.parameters(), lr=1e-4)\n",
        "scheduler_cnn = optim.lr_scheduler.StepLR(optimizer_cnn, step_size=3, gamma=0.1)\n",
        "\n",
        "cnn_train_time = train_model(cnn_model, trainloader, criterion, optimizer_cnn, scheduler_cnn, epochs=NUM_EPOCHS)\n",
        "cnn_acc, cnn_inf_time = evaluate_model(cnn_model, testloader)\n",
        "\n",
        "# 5. Model 2: Vision Transformer (ViT - Tiny)\n",
        "print(\"\\n--- Training Vision Transformer (ViT) ---\")\n",
        "vit_model = timm.create_model('vit_tiny_patch16_224', pretrained=True, num_classes=10)\n",
        "vit_model = vit_model.to(device)\n",
        "optimizer_vit = optim.Adam(vit_model.parameters(), lr=1e-4)\n",
        "scheduler_vit = optim.lr_scheduler.StepLR(optimizer_vit, step_size=3, gamma=0.1)\n",
        "\n",
        "vit_train_time = train_model(vit_model, trainloader, criterion, optimizer_vit, scheduler_vit, epochs=NUM_EPOCHS)\n",
        "vit_acc, vit_inf_time = evaluate_model(vit_model, testloader)\n",
        "\n",
        "# 6. Performance Comparison Summary\n",
        "print(\"\\n==============================\")\n",
        "print(\"      PERFORMANCE SUMMARY     \")\n",
        "print(\"==============================\")\n",
        "print(f\"Model          | Accuracy | Training Time | Inference Time\")\n",
        "print(f\"---------------------------------------------------------\")\n",
        "print(f\"CNN (ResNet18) | {cnn_acc*100:.2f}%    | {cnn_train_time:.2f}s        | {cnn_inf_time:.2f}s\")\n",
        "print(f\"ViT (Tiny)     | {vit_acc*100:.2f}%    | {vit_train_time:.2f}s        | {vit_inf_time:.2f}s\")\n",
        "print(\"==============================\")"
      ]
    }
